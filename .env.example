# ChaosHire runs without secrets by default.
PORT=8000

# Aggregate audit history. Raw uploaded CSV rows are never persisted.
# Render's free filesystem is ephemeral across redeploys.
CHAOSHIRE_DB_PATH=data/chaoshire.db

# Optional: protect CSV uploads and appeal submissions with X-API-Key.
# CHAOSHIRE_API_KEY=replace-with-a-long-random-secret

# Platform safeguards. A zero rate limit keeps the public portfolio demo unrestricted.
CHAOSHIRE_MAX_BODY_BYTES=5500000
CHAOSHIRE_RATE_LIMIT_PER_MINUTE=0

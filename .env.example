# ChaosHire runs without secrets by default, but the defaults below are the
# bounded ones: a deployment that configures nothing is still rate-limited and
# still refuses to publish anonymous uploads.
PORT=8000

# Aggregate audit history. Raw uploaded CSV rows are never persisted.
# Render's free filesystem is ephemeral across redeploys.
CHAOSHIRE_DB_PATH=data/chaoshire.db

# --- write access -----------------------------------------------------------
# Protects the mutating routes (POST /api/upload, /api/appeals,
# /api/connectors/audit). Send it as the X-API-Key header.
#
# Holding the key is what makes an upload *published*: it is written to the
# persistent audit history and becomes the shared dataset=uploaded artifact.
# Anonymous uploads are audited, returned to the caller, and discarded.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# CHAOSHIRE_API_KEY=replace-with-a-long-random-secret

# Allow unauthenticated visitors to use the demo's write forms at all.
# Default 1 so a local run and the public portfolio demo stay interactive.
# Set to 0 for a private deployment: with a key configured the gateway then
# answers 401, and with no key configured it answers 503 instead of silently
# accepting writes (the old behaviour, which was a no-op).
CHAOSHIRE_ALLOW_ANONYMOUS_WRITES=1

# --- rate limits ------------------------------------------------------------
# 0 disables the limiter. The defaults are deliberately non-zero.
CHAOSHIRE_RATE_LIMIT_PER_MINUTE=120
CHAOSHIRE_WRITE_RATE_LIMIT_PER_MINUTE=6
CHAOSHIRE_MAX_BODY_BYTES=5500000

# Set to 1 only behind a trusted reverse proxy (Render, nginx, ALB). When on,
# the left-most X-Forwarded-For entry (the client IP Render observed) is used
# as the rate-limit bucket so each real client gets its own budget instead of
# everyone sharing the proxy's. A process-wide write backstop at the same
# budget enforces the advertised cap even when per-client keys diverge.
# Prove it live with: python scripts/probe_xff.py --host <host> --limit 6
CHAOSHIRE_TRUST_FORWARDED_FOR=0

# --- bounded demo state -----------------------------------------------------
# The appeal queue is a capped FIFO in process memory. Beyond this many entries
# the oldest *anonymous* appeal is evicted first; authenticated appeals are
# only dropped when no anonymous entry remains. 200 x 5,000 characters is ~1 MB.
CHAOSHIRE_MAX_APPEALS=200

# Extra per-client budget on anonymous POST /api/appeals, on top of the write
# budget. 0 disables the extra limiter. Authenticated appeals skip it.
CHAOSHIRE_ANONYMOUS_APPEALS_PER_MINUTE=2

# Public /api/meta includes budgets, key-presence and bucketing when this is
# on. Default follows CHAOSHIRE_ALLOW_ANONYMOUS_WRITES (demo = on, private =
# off). Set 0 on any deployment that handles real data.
# CHAOSHIRE_DISCLOSE_WRITE_POSTURE=0

# Declare that CHAOSHIRE_DB_PATH sits on a volume that survives redeploy.
# Defaults to 0 — honest for Render free. Do not set this unless a disk or
# managed database is actually attached.
CHAOSHIRE_AUDIT_HISTORY_DURABLE=0

# --- optional: authenticated remote decision connectors ---------------------
# JSON list; the credential itself stays in its own env var, named by
# api_key_env, and is never logged or echoed by /api/adapters.
# CHAOSHIRE_REMOTE_MODELS=[{"model_id":"acme-v4","url":"https://models.example/decisions","api_key_env":"ACME_KEY"}]
# ACME_KEY=...

# --- optional: PostgreSQL repository backend -------------------------------
# SQLite stays the zero-config default. Set CHAOSHIRE_DB_BACKEND=postgres and
# provide a psycopg2 connection string to use a managed database instead.
# CHAOSHIRE_DB_BACKEND=postgres
# CHAOSHIRE_DATABASE_URL=postgresql://user:pass@host:5432/chaoshire

# --- optional: structured JSON log shipping --------------------------------
# When set, key events (audit.completed, appeal.created, chaos.completed,
# mitigation.completed, upload.completed) are POSTed as JSON to this URL on a
# background thread. Failures are logged but never block the request.
# CHAOSHIRE_LOG_WEBHOOK_URL=https://logs.example.com/ingest
# Optional HMAC-SHA256 signature of each payload, sent as X-ChaosHire-Signature.
# CHAOSHIRE_LOG_WEBHOOK_SECRET=replace-with-a-shared-secret

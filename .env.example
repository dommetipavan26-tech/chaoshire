# ChaosHire runs without secrets by default, but the defaults below are the
# bounded ones: a deployment that configures nothing is still rate-limited and
# still refuses to publish anonymous uploads.
PORT=8000

# Aggregate audit history. Raw uploaded CSV rows are never persisted.
# Render's free filesystem is ephemeral across redeploys.
CHAOSHIRE_DB_PATH=data/chaoshire.db

# --- write access -----------------------------------------------------------
# Protects the mutating routes (POST /api/upload, /api/appeals,
# /api/connectors/audit). Send it as the X-API-Key header.
#
# Holding the key is what makes an upload *published*: it is written to the
# persistent audit history and becomes the shared dataset=uploaded artifact.
# Anonymous uploads are audited, returned to the caller, and discarded.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# CHAOSHIRE_API_KEY=replace-with-a-long-random-secret

# Allow unauthenticated visitors to use the demo's write forms at all.
# Default 1 so a local run and the public portfolio demo stay interactive.
# Set to 0 for a private deployment: with a key configured the gateway then
# answers 401, and with no key configured it answers 503 instead of silently
# accepting writes (the old behaviour, which was a no-op).
CHAOSHIRE_ALLOW_ANONYMOUS_WRITES=1

# --- rate limits ------------------------------------------------------------
# 0 disables the limiter. The defaults are deliberately non-zero.
CHAOSHIRE_RATE_LIMIT_PER_MINUTE=120
CHAOSHIRE_WRITE_RATE_LIMIT_PER_MINUTE=6
CHAOSHIRE_MAX_BODY_BYTES=5500000

# Set to 1 only behind a trusted reverse proxy (Render, nginx, ALB). When on,
# the right-most X-Forwarded-For entry is used as the rate-limit bucket so each
# real client gets its own budget instead of everyone sharing the proxy's.
CHAOSHIRE_TRUST_FORWARDED_FOR=0

# --- bounded demo state -----------------------------------------------------
# The appeal queue is a capped FIFO in process memory. Beyond this many entries
# the oldest appeal is evicted and counted; 200 x 5,000 characters is ~1 MB.
CHAOSHIRE_MAX_APPEALS=200

# --- optional: authenticated remote decision connectors ---------------------
# JSON list; the credential itself stays in its own env var, named by
# api_key_env, and is never logged or echoed by /api/adapters.
# CHAOSHIRE_REMOTE_MODELS=[{"model_id":"acme-v4","url":"https://models.example/decisions","api_key_env":"ACME_KEY"}]
# ACME_KEY=...
